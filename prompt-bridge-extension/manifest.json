{
  "manifest_version": 3,
  "name": "AI Bridge CLI",
  "version": "1.0",
  "description": "Bridge for CLI to platform AI Chat (Gemini, ChatGPT, DeepSeek, Claude, Z.ai)",
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://claude.ai/*",
        "https://chat.z.ai/*",
        "https://grok.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.qwen.ai/*",
        "https://www.google.com/webhp?prompt=*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}